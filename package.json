{
  "name": "qa-agent-ui",
  "version": "0.1.7",
  "private": true,
  "description": "Autonomous QA projects, tasks and reporting to Jira and Slack, driven by Claude Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/EdiBianco/qa-agent.git"
  },
  "bin": {
    "qa-agent": "bin/qa-agent.js"
  },
  "scripts": {
    "start": "node server.js",
    "serve": "node bin/qa-agent.js serve --open",
    "install-launcher": "node bin/qa-agent.js install",
    "uninstall-launcher": "node bin/qa-agent.js uninstall",
    "icons": "node scripts/make-icons.js",
    "update": "node bin/qa-agent.js update"
  },
  "engines": {
    "node": ">=18"
  }
}
